# Server-only secrets. Set these in Vercel Settings > Environment Variables.
ADMIN_PASSWORD=
SESSION_SECRET=
# Neon pooled Postgres URL (or another TLS-enabled Postgres provider).
DATABASE_URL=
# Ably server API key: publish + subscribe on the vyuha:scores channel.
ABLY_API_KEY=
# Development only: use a local JSON store when DATABASE_URL is absent.
LOCAL_DEMO=true
