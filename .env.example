# Server-only secrets. Set these in Vercel Settings > Environment Variables.
ADMIN_PASSWORD=
SESSION_SECRET=
# Supabase dashboard > Project Settings > Data API / API Keys.
SUPABASE_URL=
# Server only: sb_secret_... (legacy service_role key also works).
SUPABASE_SECRET_KEY=
# Public browser key: sb_publishable_... (legacy anon key also works).
SUPABASE_PUBLISHABLE_KEY=
# Development only: local JSON storage when Supabase is not configured.
LOCAL_DEMO=true
